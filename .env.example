# Modèle de configuration. Copiez ce fichier en `.env` pour personnaliser vos réglages :
#     cp .env.example .env
# Le fichier `.env` reste sur votre machine (il est ignoré par git). Ce fichier-ci, lui, est publié.

# Adresse du serveur Ollama (embeddings calculés en local)
OLLAMA_URL=http://localhost:11434

# Modèle d'embeddings
EMBEDDING_MODEL=bge-m3

# Nombre de textes envoyés à Ollama à chaque appel
EMBEDDING_BATCH_SIZE=16

# --- Génération des réponses ---------------------------------------------------------------
# Valeurs de départ, reprises de la version TypeScript ; elles se règlent par la mesure.

# Modèle qui rédige la réponse (il doit être installé : `ollama pull llama3.2:3b`)
CHAT_MODEL=llama3.2:3b

# Fenêtre de contexte demandée à Ollama, en tokens. Au-delà, Ollama tronque le prompt en silence.
NUM_CTX=4096

# Place réservée à la réponse dans cette fenêtre, en tokens (doit rester inférieure à NUM_CTX)
MAX_OUTPUT_TOKENS=512

# Nombre d'extraits retrouvés pour chaque question
TOP_K=4

# Score minimal du meilleur extrait (cosinus, de -1 à 1). En dessous : « je ne sais pas », sans appeler le modèle.
MIN_SCORE=0.55

# Délai maximal d'attente d'une réponse du modèle, en secondes. Sur un Mac sans carte graphique,
# lire un prompt neuf de 800 tokens prend environ une minute : ne le réglez pas trop bas.
CHAT_TIMEOUT=300

# --- Qui rédige les réponses : en local (Ollama) ou à distance (Claude) -----------------------
# « ollama »    : le modèle tourne sur votre machine (gratuit, privé, lent sans carte graphique).
# « anthropic » : Claude répond à distance (rapide, payant au token). ATTENTION : les extraits de vos
#                 documents quittent alors votre machine ; à réserver à des documents publics.
CHAT_PROVIDER=ollama

# Modèle Claude utilisé quand CHAT_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-5-5

# Votre clé d'API Anthropic (créée dans la console Anthropic). À mettre UNIQUEMENT dans votre .env,
# jamais dans ce fichier : .env est ignoré par git, .env.example est publié.
ANTHROPIC_API_KEY=
